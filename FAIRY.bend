def eye_y() -> F32: 50.0
def eye_spacing() -> F32: 17.0
def eye_scale() -> F32: 1.0800000429153442

# Circular cross-sections for a thin filament, without a flat face or a length-based depth boost.
def tube_height(+radius: F32, distance: F32) -> F32:
  +off = F32.max(0.0, (radius - distance : F32))
  F32.sqrt(F32.max(0.0, (radius * radius - off * off : F32)))
def tube_inset(+radius: F32, +level: F32) -> F32:
  (radius - F32.sqrt(F32.max(0.0, (radius * radius - level * level : F32))) : F32)


# The core has equal radii in x, y and z.
def radius() -> F32: 20.5
def center_y() -> F32: 52.0
def sphere_height(+x: F32, +y: F32) -> F32:
  +dx = (x - 50.0 : F32)
  +dy = (y - center_y() : F32)
  F32.sqrt(F32.max(0.0, (radius() * radius() - dx * dx - dy * dy : F32)))
